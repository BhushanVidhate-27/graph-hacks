# --- Anthropic (Soham's agent loop) ---
ANTHROPIC_API_KEY=

# --- FalkorDB: local Docker (default) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=helio

# --- FalkorDB CLOUD ---
# Cloud refuses plain TCP, uses a non-default port, and requires credentials.
# Set FALKORDB_SSL=true. Never commit real values — copy .env.example, edit .env.
# FALKORDB_HOST=<your-instance-host>
# FALKORDB_PORT=<your-instance-port>
# FALKORDB_USERNAME=<user>
# FALKORDB_PASSWORD=<password>
# FALKORDB_SSL=true
