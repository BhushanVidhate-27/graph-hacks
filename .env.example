# ---------------------------------------------------------------------------
# Model provider
#
# The provider is entirely env-driven — no code change to switch. Only two
# variables matter: the base URL and the key.
#
# ⚠️  ANTHROPIC_BASE_URL semantics differ per provider, and getting it wrong
#     404s in a confusing way:
#
#   Anthropic direct   ANTHROPIC_BASE_URL is unset (default api.anthropic.com)
#   OpenRouter         https://openrouter.ai/api        <- /api, NOT /api/v1
#
#   The Anthropic SDK appends /v1/messages itself. So OpenRouter's documented
#   .../api/v1 produces /api/v1/v1/messages and a 404. Use .../api exactly.
#
# FREE OPTIONS — no card, no spend:
#   OpenRouter  openrouter.ai/models      — append ":free" to a model slug.
#              Works, but rate-limits hard: a 20-question sweep trips it and
#              later questions fail with 401 "User not found", which looks like a
#              broken agent rather than a busy provider. Set ANTHROPIC_FALLBACK_
#              MODELS to two or three free slugs so a throttled one can fail over.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Model provider — OpenRouter, with an optional chain of keys.
#
#   OPENROUTER_API_KEY_1   primary. This is all you need.
#   OPENROUTER_API_KEY_2   used automatically when key 1 is rate-limited.
#
# Why two? The free-tier allowance is counted PER ACCOUNT
# ("free-models-per-day", 50/day). One exhausted key fails every model in the
# chain at once, which reads as a total outage. A second key is a second
# allowance, and because the retry loop walks keys first and models second, a
# dead key costs one extra round trip instead of the whole answer.
#
# ANTHROPIC_API_KEY is still read as a fallback so an existing .env keeps
# working untouched.
#
# ⚠️  Base-URL semantics: the Anthropic SDK appends /v1/messages itself, so
#     OpenRouter's documented ".../api/v1" would become /api/v1/v1/messages.
#     Leave the default below alone unless you are pointing at something else.
#
# FREE MODELS — no spend:
#   Append ":free" to a slug in ANTHROPIC_FALLBACK_MODELS below. They rate-limit
#   hard: a 20-question sweep trips the daily cap and later questions fail with
#   429 "free-models-per-day". The key chain and the model chain both cover
#   that; a paid slug in ANTHROPIC_MODEL is unaffected by the free cap.
# ---------------------------------------------------------------------------

OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=

ANTHROPIC_API_KEY=

ANTHROPIC_BASE_URL=https://openrouter.ai/api

ANTHROPIC_MODEL=claude-sonnet-4-5

# Tried in order when the primary keeps failing. Comma-separated, order matters.
# Only useful on free tiers, where one model being busy should not kill the demo.
# ANTHROPIC_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free

# Response budget per round. Some providers reject the WHOLE request when
# max_tokens exceeds the remaining balance rather than truncating, so a thin
# account gets no answer at all. Lower this if you see HTTP 402.
ANTHROPIC_MAX_TOKENS=1024

# 1 = answer from mock/trail.json and never touch the graph.
# 0 = call the agent, which calls app/graph.py.
# GET /health returns {"mock": true|false} — check it before you trust a demo.
USE_MOCK=0

# ---------------------------------------------------------------------------
# FalkorDB
#
# FALKORDB_SSL defaults off. FalkorDB Cloud's instance port answers PLAINTEXT
# Redis despite the console implying TLS, so setting this true makes the driver
# open a handshake the server never answers and the connection HANGS rather than
# erroring — which looks like a slow network, not a config mistake.
# ---------------------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=helio
